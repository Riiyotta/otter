{
  "$comment": "The closed list of what an AI generator is allowed to override. GENERATED FROM the real section contracts and cross-checked against schema/pagespec.schema.json by extraction/verify_all.py -- never hand-copied, so it cannot go stale against the schema. Anything absent from settableProperties is not settable.",
  "version": "1.0.0",
  "designSystems": {
    "marketing": "The Webflow-derived marketing site. Theme marketing-light.",
    "auth": "The app host (/log-in): Vite + React + Mantine. Theme auth-light. A SEPARATE design system -- different grid, breakpoints, spacing, radii and line-height. Its tokens live in tokens/themes/auth-light.json and must never be merged into the marketing set. The two share only the two font families and the brand hexes."
  },
  "globalRules": [
    "A generator may set only the properties listed under a section's settableProperties. Everything else is contract-owned.",
    "Every text field must respect its maxWords budget.",
    "Every media field must carry an assetRole from the closed enum in assets/asset-roles.json, and that role must be in the field's own assetRoles list.",
    "For any role whose generationPolicy is not may-generate-new, assetRef must be one of the files that role already declares. A generator may reference an existing asset but must never invent one.",
    "Motion may only use a pattern from the section's allowedMotionPatterns, and reducedMotionFallback must equal the section's declared fallback.",
    "No token values may be overridden per instance. This schema has NO per-instance style/token-override field at all -- styling is owned entirely by the section and component contracts. Recorded explicitly so nobody looks for a mechanism that does not exist.",
    "Never emit or imitate the real third-party press marks, the Otter wordmark, brand illustrations, real people's photographs, or operative legal text. See assets/asset-roles.json.",
    "Never reintroduce /sign-up or /welcome as local routes.",
    "Never give an instance of auth.login-form any form of credential submission."
  ],
  "tokenOverridePolicy": {
    "perInstanceOverridesSupported": false,
    "statement": "There is deliberately no PageSpec-level token-override field. Adversarial coverage for token misuse therefore lives at the catalog layer (extraction/verify_all.py's drift-injection tests), not at the PageSpec layer, because the PageSpec layer has nothing to mutate.",
    "rawValueRestrictions": {
      "color": "Only the 9 foundation colours in tokens/00-foundation/color.json. No new hex may be introduced.",
      "fontFamily": "Only font.display and font.sans.",
      "fontSize": "Only the measured roles in tokens/00-foundation/typography.json#/scale.",
      "radius": "Only the tokens in tokens/00-foundation/radius.json.",
      "elevation": "Only the three in tokens/00-foundation/elevation.json; two of them are deliberately untransitioned.",
      "motion": "Only the durations, delays and the one easing curve in tokens/00-foundation/motion.json.",
      "clipPath": "Closed at the 7 ids in tokens/00-foundation/clip-path.json. No new path data."
    },
    "rawValueRestrictionsNote": "These category keys are the real top-level/section key names in the token files they govern, so a drift check can resolve each one against something that actually exists rather than against a convenient human label."
  },
