{
  "pageSpecVersion": "1.1.0",
  "mode": "generation",
  "route": "*",
  "template": "not-found",
  "designSystem": "marketing",
  "theme": "marketing-light",
  "tokens": {
    "surface": "semantic.surface.page",
    "text": "semantic.text.primary",
    "fontDisplay": "typography.font.display",
    "fontBody": "typography.font.sans",
    "sectionPadding": "spacing.section.default",
    "cardRadius": "radius.card",
    "buttonRadius": "radius.pill"
  },
  "nodes": [
    {
      "section": "chrome.navbar",
      "content": {
        "variant": "site"
      },
      "motion": {
        "pattern": "mobileNav.open",
        "reducedMotionFallback": "instant-switch"
      },
      "variant": "site"
    },
    {
      "section": "content.stub-notice",
      "content": {
        "text": "This page is still being written."
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      }
    },
    {
      "section": "chrome.footer",
      "content": {
        "variant": "site"
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      },
      "variant": "site"
    }
  ],
  "generationContext": {
    "brandName": "Kettlewood",
    "brandMark": {
      "assetRole": "placeholder.brandMark",
      "assetRef": "placeholder/kettlewood-mark.svg"
    },
    "siteUrl": "https://kettlewood.example",
    "appUrl": "https://app.kettlewood.example",
    "socialLinks": [
      {
        "label": "Newsletter",
        "href": "https://kettlewood.example/newsletter"
      },
      {
        "label": "Community",
        "href": "https://kettlewood.example/community"
      }
    ]
  }
}
