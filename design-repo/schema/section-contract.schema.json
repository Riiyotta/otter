{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://design-repo.local/otter/section-contract.schema.json",
  "title": "Otter section contract",
  "description": "Closed shape of every sections/*.json contract (BASELINE R7/R8). Validated for every contract by extraction/verify_all.py (section-contracts check). `source` = what the DOM/component is (traceable, generated by extraction/build_section_provenance.py); `semantic` = what the AI sees. retrievalEligible is a closed boolean; false requires a 30+ char retrievalReason.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "category",
    "designSystem",
    "variants",
    "content",
    "constraints",
    "motion",
    "responsive",
    "assetRoles",
    "generatedAssetRoles",
    "observedOn",
    "measuredFrom",
    "source",
    "semantic",
    "retrievalEligible"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9-]+$"
    },
    "kind": {
      "const": "section"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "enum": [
        "auth",
        "banner",
        "benefits",
        "blog",
        "chrome",
        "content",
        "conversion",
        "disclosure",
        "faq",
        "form",
        "hero",
        "jobs",
        "legal",
        "process",
        "stats",
        "testimonials",
        "trust",
        "values"
      ]
    },
    "designSystem": {
      "enum": [
        "marketing",
        "auth"
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "content": {
      "type": "object",
      "required": [
        "type",
        "additionalProperties",
        "properties",
        "required"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedTemplates": {},
        "contentProvenance": {},
        "documentParts": {},
        "exactlyThree": {},
        "exactlyThreeCards": {},
        "fixedCopy": {},
        "forbiddenFields": {},
        "forbiddenFieldsReason": {},
        "forbiddenOnRoutes": {},
        "homeRouteOnly": {},
        "honestEvidenceLevel": {},
        "inertForm": {},
        "leadingEmptyContainer": {},
        "licensing": {},
        "maxPerPage": {},
        "mustBeFirst": {},
        "mustBeInsideMain": {},
        "mustBeLast": {},
        "mustBeLastBeforeFooter": {},
        "mustFollowNav": {},
        "mustPrecedeMain": {},
        "noConsecutiveException": {},
        "noEmptyState": {},
        "noEndpoint": {},
        "noFabrication": {},
        "noHero": {},
        "noInlineCta": {},
        "noInventedContent": {},
        "noLegalText": {},
        "noPanel": {},
        "noTableOfContents": {},
        "notSticky": {},
        "note": {},
        "onePerPage": {},
        "repeatable": {},
        "scopeReduction": {},
        "separateDesignSystem": {},
        "signOffRequired": {},
        "singleSection": {},
        "skipLink": {},
        "soleSectionOnTemplate": {},
        "statCountByVariant": {},
        "variantKeyed": {},
        "variantMustDiffer": {},
        "widerContainer": {}
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedPatterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "accordionCloseDelayMs": {},
        "accordionMs": {},
        "accordionOpenDelayMs": {},
        "allowedPatterns": {},
        "appliesTo": {},
        "asymmetricTiming": {},
        "buttonMs": {},
        "closeDurationMs": {},
        "delayMs": {},
        "desktopOpacityMs": {},
        "desktopSlideMs": {},
        "desktopSlideReplaysOnSwitch": {},
        "durationMs": {},
        "easing": {},
        "firesOnce": {},
        "inputMs": {},
        "labelMs": {},
        "note": {},
        "openDurationMs": {},
        "perPropertyDelays": {},
        "reducedMotionFallback": {},
        "stagger": {},
        "triggerOffsetPercentOfViewport": {}
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {},
        "breakpointNote": {},
        "desktop": {},
        "le479": {},
        "le767": {},
        "le991": {},
        "mobilePanel": {}
      }
    },
    "assetRoles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generatedAssetRoles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observedOn": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "measuredFrom": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]+\\.(md|css|jsx|js|json|html):\\d+-\\d+$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tag",
        "file",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "file": {
          "type": "string",
          "pattern": "^src/[A-Za-z0-9_./-]+\\.(jsx|js)$"
        },
        "lines": {
          "type": "string",
          "pattern": "^\\d+-\\d+$"
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "HERO",
            "SHELL",
            "CTA",
            "FEATURES",
            "CONTENT",
            "EDITORIAL",
            "SOCIAL_PROOF",
            "TRUST",
            "FAQ",
            "FORM",
            "LEGAL",
            "STATS",
            "AUTH",
            "UTILITY"
          ]
        }
      }
    },
    "retrievalEligible": {
      "type": "boolean"
    },
    "retrievalReason": {
      "type": "string",
      "minLength": 30
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retrievalEligible": {
            "const": false
          }
        },
        "required": [
          "retrievalEligible"
        ]
      },
      "then": {
        "required": [
          "retrievalReason"
        ]
      }
    }
  ]
}
